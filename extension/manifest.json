{
  "manifest_version": 3,
  "name": "SSERA Pro - Secure Reply Assistant",
  "version": "1.0",
  "description": "Privacy-first AI reply assistant with automatic masking",

  "permissions": ["activeTab", "storage", "scripting"],

  "host_permissions": [
    "https://your-api-url.com/*",
    "https://api.groq.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "setup.html"
  },

  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["style.css"]
  }]
}